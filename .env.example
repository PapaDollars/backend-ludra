# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_here_minimum_32_characters
JWT_REFRESH_EXPIRES_IN=7d

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour-private-key\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Cloudinary (stockage des images — obligatoire)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Paiements Mobile Money (src/services/mobileMoney.js)
# simulation : paiement "paid" ~6 s après la demande, numéro finissant par 0000 = échec (défaut hors production,
# refusé en production). none : paiements indisponibles (503). Aucun fournisseur réel n'est encore branché.
PAYMENT_PROVIDER=simulation

# Orange Money Cameroun (PAYMENT_PROVIDER=orange_cm, opérateur orange_money uniquement ; mtn_momo ⇒ 503).
# ⚠ Chemins/champs issus du client communautaire NdoleStudio/orangemoney-go, NON confirmés par Orange :
#    voir src/services/providers/orangeCM.js. Tout est à valider avec la doc marchand Orange avant la production.
# Valeur par défaut de orangemoney-go (non confirmée) : https://api-s1.orange.cm
ORANGE_BASE_URL=
ORANGE_USERNAME=
ORANGE_PASSWORD=
ORANGE_X_AUTH_TOKEN=
# Compte marchand (channelUserMsisdn) et PIN : secrets, jamais commités ni journalisés
ORANGE_CHANNEL_MSISDN=
ORANGE_PIN=
# Indicatif ajouté devant 6XXXXXXXX dans les MSISDN envoyés (format attendu NON vérifié) ; vide = tel quel
ORANGE_MSISDN_PREFIX=
# URL publique du callback = https://<api>/api/payments/webhooks/orange/<ORANGE_WEBHOOK_SECRET>
# Secret long et aléatoire (ex. openssl rand -hex 32)
ORANGE_NOTIF_URL=
ORANGE_WEBHOOK_SECRET=
# Réconciliation planifiée des paiements pending (défaut 60000 ms, minimum 15000)
PAYMENT_RECONCILE_INTERVAL_MS=60000

# Frontend URL (CORS, liens de l'export CSV de la shortlist)
FRONTEND_URL=http://localhost:3000

# Email via Brevo (smtp-relay.brevo.com)
# Brevo > SMTP & API > Clés SMTP
BREVO_SMTP_LOGIN=your-brevo-account@email.com
BREVO_SMTP_KEY=your-brevo-smtp-key
EMAIL_FROM=noreply@ludra.cm
